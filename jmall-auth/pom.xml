<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jmall</groupId>
        <artifactId>jmall</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>jmall-auth</artifactId>
    <name>jmall-auth</name>
    <description>J-Mall 认证服务 - 注册/登录/Token管理</description>

    <dependencies>
        <!-- 公共Web模块（全局异常/参数校验/SpringDoc） -->
        <dependency>
            <groupId>com.jmall</groupId>
            <artifactId>jmall-common-web</artifactId>
        </dependency>
        <!-- 公共MyBatis模块 -->
        <dependency>
            <groupId>com.jmall</groupId>
            <artifactId>jmall-common-mybatis</artifactId>
        </dependency>
        <!-- 公共Redis模块 -->
        <dependency>
            <groupId>com.jmall</groupId>
            <artifactId>jmall-common-redis</artifactId>
        </dependency>
        <!-- 公共安全模块（Sa-Token） -->
        <dependency>
            <groupId>com.jmall</groupId>
            <artifactId>jmall-common-security</artifactId>
        </dependency>
        <!-- 用户服务API（注册/登录需调用） -->
        <dependency>
            <groupId>com.jmall</groupId>
            <artifactId>jmall-api-user</artifactId>
        </dependency>
        <!-- BCrypt 密码加密（仅使用 crypto，不引入完整 Spring Security） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Nacos 注册中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- OpenFeign -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- LoadBalancer -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Bootstrap 配置加载 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>