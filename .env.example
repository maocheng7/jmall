# ============================================================
# J-Mall 环境变量样例
# 用法：cp .env.example .env，按需修改后 docker compose up -d
# 注意：请勿将真实密钥提交到仓库
# ============================================================

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Nacos ----
NACOS_ADDR=127.0.0.1:8848
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=
# Nacos 鉴权（docker-compose 内部用，≥2.3 强制）
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=jmall
NACOS_AUTH_IDENTITY_VALUE=jmall

# ---- Elasticsearch（可选） ----
ES_HOST=127.0.0.1
ES_PORT=9200
ES_PASSWORD=

# ---- RocketMQ（可选） ----
ROCKETMQ_NAMESERVER=127.0.0.1:9876

# ---- MinIO（可选） ----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=jmall
MINIO_SECRET_KEY=jmall12345
MINIO_PORT=9000

# ---- Seata（可选） ----
SEATA_ADDR=127.0.0.1:8091

# ---- Sentinel（可选） ----
SENTINEL_DASHBOARD=127.0.0.1:8858
